# Copy this file to .env (in backend/auth) and fill in your values.

# Tiger Data connection string (the TIMESCALE_SERVICE_URL from your Tiger credentials file)
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this server. Google redirects to $BETTER_AUTH_URL/api/auth/callback/google,
# so a phone must be able to reach it (use a tunnel like ngrok when testing on a device).
BETTER_AUTH_URL=http://localhost:8000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the API (8081 = the Expo app in a browser)
TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

PORT=8000

# Deep link scheme of the app (frontend/app.json "scheme")
APP_SCHEME=safestep
