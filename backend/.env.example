# Copy to backend/.env and fill in. Never commit the real .env.

# Shared secret the app sends in the X-API-Key header.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SAFESTEP_API_KEY=

# Twilio (https://console.twilio.com). Leave blank to log alerts instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number you own...
TWILIO_FROM_NUMBER=
# ...or a Messaging Service SID (use one or the other).
TWILIO_MESSAGING_SERVICE_SID=

# Max alerts per caller per window (seconds).
ALERTS_PER_WINDOW=5
RATE_WINDOW_SECONDS=600
