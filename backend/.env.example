# Copy this file to .env (in this backend folder) and fill in your values.

# Tiger Data connection string (the TIMESCALE_SERVICE_URL from your Tiger credentials file)
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Clerk Dashboard -> API keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Comma-separated browser origins allowed to call the API
# (8000 = the /dev page, 8081 = the Expo app in a browser). The phone app needs no entry.
CLERK_AUTHORIZED_PARTIES=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8081,http://127.0.0.1:8081
