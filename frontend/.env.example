# Copy this file to .env (in this frontend folder) and fill in your values.
# Restart `npx expo start` after changing it.

# Clerk Dashboard -> API keys (same publishable key as the backend uses)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional. Leave unset and the app uses the computer running Expo, port 8000.
# Set it if the app can't reach the backend, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
