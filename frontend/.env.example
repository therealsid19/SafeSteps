# Copy this file to .env.local (in this frontend folder) and fill in your values.
# Restart `npx expo start` after changing it.

# Must be exactly BETTER_AUTH_URL from backend/auth/.env, or Google sign-in fails
# with "state_mismatch". localhost works on web and the iOS simulator.
# On a real phone, use a tunnel (e.g. `ngrok http 8000`) for both values, since
# Google won't redirect to a 192.168.x.x address.
EXPO_PUBLIC_API_URL=http://localhost:8000
