{
  "expo": {
    "name": "SafeStep",
    "slug": "SafeStep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow SafeStep to recognize your voice during a fall safety check.",
        "NSMicrophoneUsageDescription": "Allow SafeStep to listen for your response after a possible fall."
      },
      "bundleIdentifier": "com.jeffreyyu.safestep",
      "appleTeamId": "YBP8N453TC"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.jeffreyyu.safestep"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SafeStep to listen for your response after a possible fall.",
          "speechRecognitionPermission": "Allow SafeStep to recognize your voice during a fall safety check."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow SafeStep to detect sudden movements that may indicate a fall."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SafeStep to share your location with your caregivers."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SafeStep to use your camera to warn you about obstacles and find objects.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withSceneLifecycle",
      "onnxruntime-react-native",
      [
        "expo-notifications",
        {
          "defaultChannel": "fall-alerts"
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "safestep",
    "extra": {
      "eas": {
        "projectId": "e5a9d935-1b44-4518-bfa7-f6d828fc6bfc"
      }
    },
    "owner": "usbsas-team"
  }
}
