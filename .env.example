# Copy to .env.local (git-ignored) and fill in, then restart `npx expo start`.

# Where the SafeStep backend is running. On a real phone use your computer's
# local network IP (e.g. http://192.168.1.20:8000), not localhost.
EXPO_PUBLIC_SAFESTEP_API_URL=

# Must match SAFESTEP_API_KEY in backend/.env.
# Note: EXPO_PUBLIC_ values are built into the app, so this only stops casual
# abuse. Switch to Clerk session tokens before a public release.
EXPO_PUBLIC_SAFESTEP_API_KEY=
